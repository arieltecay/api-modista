{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/meta-dlq",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/invoices",
      "schedule": "30 6 * * *"
    }
  ]
}
